{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Inspector semantic requirements handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "necessity", "source", "confidence", "evidence"],
        "properties": {
          "type": {"enum": ["runtime", "command", "environmentVariable", "file", "directory", "operatingSystem", "package"]},
          "ecosystem": {"enum": ["python", "npm", "maven"], "description": "Required only when type is package."},
          "name": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Canonical dependency name; use operating-system for operatingSystem."},
          "required": {"type": "string", "maxLength": 500, "description": "Backward-compatible constraint field. Defaults to * for runtimes/packages and present otherwise."},
          "version": {"type": "string", "maxLength": 500, "description": "Package version constraint; alias of required for package entries."},
          "necessity": {"enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
          "source": {"type": "string", "const": "INFERRED"},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 500},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["file"],
                "properties": {
                  "file": {"type": "string", "minLength": 1, "maxLength": 500},
                  "matched": {"type": "string", "maxLength": 240},
                  "inferenceRule": {"type": "string", "maxLength": 500}
                }
              }
            ]
          },
          "matched": {"type": "string", "maxLength": 240},
          "inferenceRule": {"type": "string", "maxLength": 500}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "package"}}, "required": ["type"]},
            "then": {"required": ["ecosystem"]},
            "else": {"not": {"required": ["ecosystem"]}}
          }
        ]
      }
    }
  }
}
