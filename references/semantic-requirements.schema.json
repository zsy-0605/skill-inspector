{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Inspector semantic requirements handoff 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1", "1.2"]},
    "requirements": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "name", "necessity", "source", "confidence", "evidence"],
        "properties": {
          "type": {"enum": ["runtime", "command", "environmentVariable", "file", "directory", "operatingSystem", "package", "capability", "skill"]},
          "ecosystem": {"enum": ["python", "npm", "maven"]},
          "capabilityKind": {"enum": ["mcpServer", "tool", "capability"]},
          "namespace": {"type": "string", "maxLength": 500, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 500},
          "required": {"type": "string", "maxLength": 500},
          "version": {"type": "string", "maxLength": 500},
          "necessity": {"enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
          "source": {"const": "INFERRED"},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 500},
              {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {
                "file": {"type": "string", "minLength": 1, "maxLength": 500},
                "matched": {"type": "string", "maxLength": 240},
                "inferenceRule": {"type": "string", "maxLength": 500}
              }}
            ]
          },
          "matched": {"type": "string", "maxLength": 240},
          "inferenceRule": {"type": "string", "maxLength": 500}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "package"}}, "required": ["type"]}, "then": {"required": ["ecosystem"]}, "else": {"not": {"required": ["ecosystem"]}}},
          {"if": {"properties": {"type": {"const": "capability"}}, "required": ["type"]}, "then": {"required": ["capabilityKind"], "properties": {"required": {"const": "available"}}}, "else": {"not": {"required": ["capabilityKind"]}}},
          {"if": {"properties": {"type": {"const": "skill"}}, "required": ["type"]}, "else": {"not": {"required": ["namespace"]}}}
        ]
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"schemaVersion": {"const": "1.0"}}}, "then": {"properties": {"requirements": {"not": {"contains": {"properties": {"type": {"enum": ["capability", "skill"]}}, "required": ["type"]}}}}}},
    {"if": {"properties": {"schemaVersion": {"const": "1.1"}}}, "then": {"properties": {"requirements": {"not": {"contains": {"properties": {"type": {"const": "skill"}}, "required": ["type"]}}}}}}
  ]
}
