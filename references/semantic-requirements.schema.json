{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Inspector semantic requirements handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "necessity", "source", "confidence", "evidence"],
        "properties": {
          "type": {"enum": ["runtime", "command", "environmentVariable", "file", "directory", "operatingSystem"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Canonical dependency name; use operating-system for operatingSystem."},
          "required": {"type": "string", "description": "Runtime version constraint, comma-separated supported OS values, or present. Defaults to * for runtimes and present otherwise."},
          "necessity": {"enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
          "source": {"type": "string", "const": "INFERRED"},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 500},
          "matched": {"type": "string"},
          "inferenceRule": {"type": "string"}
        }
      }
    }
  }
}
