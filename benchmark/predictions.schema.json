{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skill compatibility benchmark predictions",
  "type": "object",
  "required": ["schemaVersion", "datasetVersion", "method", "model", "skills"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "datasetVersion": {"type": "string"},
    "method": {"enum": ["AGENT_ONLY", "JAVA_STATIC", "AGENT_WITH_INSPECTOR"]},
    "model": {"type": "string"},
    "environment": {"type": "string"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "readiness", "dependencies"],
        "properties": {
          "id": {"type": "string"},
          "readiness": {"enum": ["READY", "WARNING", "NOT_READY", "UNVERIFIABLE"]},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "inScope", "evidence"],
              "properties": {
                "type": {"type": "string"}, "name": {"type": "string"},
                "inScope": {"type": "boolean"}, "evidence": {"type": "string"},
                "source": {"enum": ["DECLARED", "INFERRED", "JAVA_REPORT"]},
                "confidence": {"enum": ["CERTAIN", "HIGH", "MEDIUM", "LOW"]}
              }
            }
          }
        }
      }
    }
  }
}
