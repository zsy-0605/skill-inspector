{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "notes"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ecosystem", "capabilityKind", "namespace", "name", "version", "necessity", "source", "inScope", "evidence", "notes"],
        "properties": {
          "type": {"type": "string", "enum": ["runtime", "command", "environmentVariable", "file", "directory", "operatingSystem", "package", "capability", "skill"]},
          "ecosystem": {"type": ["string", "null"], "enum": ["python", "npm", "maven", null]},
          "capabilityKind": {"type": ["string", "null"], "enum": ["mcpServer", "tool", "capability", null]},
          "namespace": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "necessity": {"type": "string", "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
          "source": {"type": "string", "enum": ["COMPATIBILITY_METADATA", "SKILL_TEXT", "SCRIPT", "REFERENCE", "MANIFEST"]},
          "inScope": {"type": "boolean"},
          "evidence": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
