{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "scope", "samples"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "datasetVersion": {"type": "string"}, "scope": {"type": "string"},
    "samples": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["skillId", "classification", "dependencies", "reason"], "properties": {
        "skillId": {"type": "string"}, "classification": {"enum": ["POSITIVE_REQUIRED", "POSITIVE_CONDITIONAL", "BOUNDARY_NEGATIVE", "NEGATIVE"]},
        "reason": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["name", "necessity", "evidence"], "properties": {
            "namespace": {"type": "string"}, "name": {"type": "string"},
            "necessity": {"enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]}, "evidence": {"type": "string"}
          }}
      }}}
    }
  }
}
