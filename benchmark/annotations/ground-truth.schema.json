{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Inspector real-world ground truth",
  "type": "object",
  "required": ["schemaVersion", "datasetVersion", "environment", "scope", "skills"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.1"},
    "datasetVersion": {"type": "string"},
    "environment": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "reviewPolicy": {"type": "string"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reviewStatus", "actualReadiness", "blockingDependencies", "dependencies", "review"],
        "properties": {
          "id": {"type": "string"},
          "reviewStatus": {"enum": ["PENDING", "DRAFT", "EVIDENCE_REVIEWED", "HUMAN_REVIEWED"]},
          "actualReadiness": {"enum": ["READY", "WARNING", "NOT_READY", "UNVERIFIABLE", null]},
          "blockingDependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "properties": {"type": {"type": "string"}, "ecosystem": {"enum": ["python", "npm", "maven"]}, "capabilityKind": {"enum": ["mcpServer", "tool", "capability"]}, "name": {"type": "string"}},
              "allOf": [
                {"if": {"properties": {"type": {"const": "package"}}}, "then": {"required": ["ecosystem"]}},
                {"if": {"properties": {"type": {"const": "capability"}}}, "then": {"required": ["capabilityKind"]}}
              ]
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "necessity", "source", "inScope", "evidence"],
              "properties": {
                "type": {"type": "string"},
                "ecosystem": {"enum": ["python", "npm", "maven"]},
                "capabilityKind": {"enum": ["mcpServer", "tool", "capability"]},
                "name": {"type": "string"},
                "required": {"type": "string"},
                "version": {"type": "string"},
                "necessity": {"enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
                "source": {"enum": ["COMPATIBILITY_METADATA", "SKILL_TEXT", "SCRIPT", "REFERENCE", "MANIFEST"]},
                "inScope": {"type": "boolean"},
                "evidence": {"type": "string"},
                "notes": {"type": "string"}
              },
              "allOf": [
                {"if": {"properties": {"type": {"const": "package"}}}, "then": {"required": ["ecosystem", "version"]}},
                {"if": {"properties": {"type": {"const": "capability"}}}, "then": {"required": ["capabilityKind"]}}
              ]
            }
          },
          "notes": {"type": "string"},
          "review": {
            "type": "object",
            "required": ["method", "reviewedAt", "humanSignoff"],
            "properties": {
              "method": {"type": "string"},
              "model": {"type": "string"},
              "reviewedAt": {"type": "string"},
              "humanSignoff": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
