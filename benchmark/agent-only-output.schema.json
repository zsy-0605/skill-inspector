{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["readiness", "requirements"],
  "properties": {
    "readiness": {"type": "string", "enum": ["READY", "WARNING", "NOT_READY", "UNVERIFIABLE"]},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ecosystem", "capabilityKind", "name", "required", "necessity", "source", "confidence", "evidence", "matched", "inferenceRule"],
        "properties": {
          "type": {"type": "string", "enum": ["runtime", "command", "environmentVariable", "file", "directory", "operatingSystem", "package", "capability"]},
          "ecosystem": {"type": ["string", "null"], "enum": ["python", "npm", "maven", null]},
          "capabilityKind": {"type": ["string", "null"], "enum": ["mcpServer", "tool", "capability", null]},
          "name": {"type": "string"},
          "required": {"type": ["string", "null"]},
          "necessity": {"type": "string", "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]},
          "source": {"type": "string", "const": "INFERRED"},
          "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence": {"type": "string"},
          "matched": {"type": ["string", "null"]},
          "inferenceRule": {"type": "string"}
        },
        "allOf": [{"if": {"properties": {"type": {"const": "capability"}}},
                   "then": {"properties": {"capabilityKind": {"type": "string"}, "required": {"const": "available"}}}}]
      }
    }
  }
}
